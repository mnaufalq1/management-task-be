                "required": [
                  "name",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User berhasil dibuat"
          }
        },
        "tags": [
          "Users"
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Mendapatkan detail user berdasarkan ID",
        "description": "Endpoint ini digunakan untuk mengambil detail data user spesifik.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID user yang akan diambil",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
