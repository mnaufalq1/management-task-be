    "/auth/register": {
      "post": {
        "summary": "Register user baru",
        "description": "Endpoint ini digunakan untuk mendaftarkan user baru.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Budi"
                  },
                  "email": {
                    "type": "string",
                    "example": "budi@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "Password123!"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pendaftaran berhasil"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user",
        "description": "Endpoint ini digunakan untuk masuk ke dalam aplikasi menggunakan akun terdaftar.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "budi@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "Password123!"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/users": {
