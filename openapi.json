        "summary": "Mendapatkan daftar semua user",
        "description": "Endpoint ini digunakan untuk mengambil seluruh user yang terdaftar dalam sistem.",
        "responses": {
          "200": {
            "description": "Berhasil mengambil daftar user"
          }
        },
        "tags": [
          "Users"
        ]
      },
      "post": {
        "summary": "Membuat user baru",
        "description": "Endpoint ini digunakan untuk menambahkan user baru ke dalam sistem.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Budi"
                  },
                  "email": {
                    "type": "string",
                    "example": "budi@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  },
                  "role": {
                    "type": "string",
                    "example": "member"
                  }
