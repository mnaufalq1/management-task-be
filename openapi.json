        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID user yang akan dihapus",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User berhasil dihapus"
          }
        },
        "tags": [
          "Users"
        ]
      }
    },
