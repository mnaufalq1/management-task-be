          "Users"
        ]
      },
      "patch": {
        "summary": "Mengupdate data user",
        "description": "Endpoint ini digunakan untuk memperbarui data user secara parsial (kirim field yang ingin diubah saja).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID user yang akan diperbarui",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Budi Baru"
                  },
                  "email": {
                    "type": "string",
                    "example": "budibaru@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "passwordbaru"
                  },
                  "role": {
                    "type": "string",
                    "example": "admin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User berhasil diperbarui"
          }
        },
        "tags": [
          "Users"
        ]
      },
      "delete": {
        "summary": "Menghapus user",
