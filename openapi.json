      },
      "post": {
        "summary": "Membuat tugas baru",
        "description": "Endpoint ini digunakan untuk menambahkan tugas baru ke dalam sistem.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Membuat dokumentasi API"
                  },
                  "description": {
                    "type": "string",
                    "example": "Menambahkan detail parameter pada openapi.json"
                  },
                  "status": {
                    "type": "string",
                    "example": "todo"
                  },
                  "priority": {
                    "type": "string",
                    "example": "high"
                  },
                  "deadline": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-08-30T12:00:00Z"
                  }
                },
                "required": ["title", "description","project_id", "status", "priority", "deadline"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tugas berhasil dibuat"
          }
        },
        "tags": [
          "Tasks"
        ]
      }
    },
