      "patch": {
        "summary": "Mengupdate tugas",
        "description": "Endpoint ini digunakan untuk mengupdate data tugas secara keseluruhan (semua field wajib dikirim).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID tugas yang akan diupdate",
            "schema": {
              "type": "string"
